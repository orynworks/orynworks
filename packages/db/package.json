    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.32.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.23.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
