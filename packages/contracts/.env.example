# Deployer private key — use a FRESH wallet, NOT your main one
# Generate via: cast wallet new
PRIVATE_KEY=0x...

# Protocol owner (can withdraw protocol fees, transfer ownership)
PROTOCOL_OWNER=0xYourMainWalletHere

# USDC token address
# Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# RPC endpoints (defaults work, override if you have private endpoint)
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_RPC=https://mainnet.base.org

# BaseScan API key for contract verification — get free at https://basescan.org/myapikey
BASESCAN_API_KEY=your-api-key-here
